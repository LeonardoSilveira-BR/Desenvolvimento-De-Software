"""
testes unitários do musicplayer.

 usando mock para
simular as bibliotecas externas e testar apenas a lógica interna."""

import unittest
from unittest.mock import MagicMock, patch
import sys
import os

# adiciona a pasta pai ao path para encontrar o musicplayer
sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
from MusicPlayer import MusicPlayer


# cria um evento fake com os mesmos atributos do musicevent real
# permite testar sem precisar importar o musicinterpreter
def _evento(nota=60, instrumento=0, volume=70, bpm=120,
            tempo_de_atraso=0, faixa=0, oitava=0):
    ev = MagicMock()
    ev.nota            = nota
    ev.instrumento     = instrumento
    ev.volume          = volume
    ev.bpm             = bpm
    ev.tempo_de_atraso = tempo_de_atraso
    ev.faixa           = faixa
    ev.oitava          = oitava
    return ev


class TestMusicPlayer(unittest.TestCase):

    def setUp(self):
        # cria um player limpo antes de cada teste
        self.player = MusicPlayer()

    #  testes de gerar_midi 

    @patch("MusicPlayer.mido")
    def test_lista_vazia_nao_gera_arquivo(self, mock_mido):
        # se não houver eventos, o arquivo não deve ser criado
        self.player.gerar_midi([])
        mock_mido.MidiFile.assert_not_called()
        self.assertFalse(self.player._arquivo_gerado)

    @patch("MusicPlayer.mido")
    def test_gerar_midi_salva_arquivo(self, mock_mido):
        # verifica se o arquivo é salvo com o nome correto
        mock_arquivo = MagicMock()
        mock_mido.MidiFile.return_value    = mock_arquivo
        mock_mido.MidiTrack.return_value   = MagicMock()
        mock_mido.bpm2tempo.return_value   = 500000
        mock_mido.MetaMessage.return_value = MagicMock()
        mock_mido.Message.return_value     = MagicMock()

        self.player.gerar_midi([_evento()])

        mock_arquivo.save.assert_called_once_with("faixa_gerada.mid")
        self.assertTrue(self.player._arquivo_gerado)

    @patch("MusicPlayer.mido")
    def test_faixas_diferentes_geram_tracks_separadas(self, mock_mido):
        # dois eventos em faixas distintas devem gerar duas tracks no midi
        mock_arquivo = MagicMock()
        mock_mido.MidiFile.return_value    = mock_arquivo
        mock_mido.MidiTrack.return_value   = MagicMock()
        mock_mido.bpm2tempo.return_value   = 500000
        mock_mido.MetaMessage.return_value = MagicMock()
        mock_mido.Message.return_value     = MagicMock()

        self.player.gerar_midi([_evento(faixa=0), _evento(faixa=1)])

        self.assertEqual(mock_mido.MidiTrack.call_count, 2)

    @patch("MusicPlayer.mido")
    def test_gerar_midi_reseta_flags_de_reproducao(self, mock_mido):
        # após gerar o midi, o player deve estar parado e não pausado
        mock_mido.MidiFile.return_value    = MagicMock()
        mock_mido.MidiTrack.return_value   = MagicMock()
        mock_mido.bpm2tempo.return_value   = 500000
        mock_mido.MetaMessage.return_value = MagicMock()
        mock_mido.Message.return_value     = MagicMock()

        self.player._tocando = True
        self.player._pausado = True
        self.player.gerar_midi([_evento()])

        self.assertFalse(self.player._tocando)
        self.assertFalse(self.player._pausado)

    # ── testes de play ────────────────────────────────────────────────────

    @patch("MusicPlayer.pygame")
    def test_play_sem_midi_gerado_nao_toca(self, mock_pygame):
        # play() não deve fazer nada se o midi ainda não foi gerado
        self.player.play()
        mock_pygame.mixer.music.load.assert_not_called()

    @patch("MusicPlayer.pygame")
    def test_play_inicia_reproducao(self, mock_pygame):
        # play() deve carregar o arquivo e chamar play no pygame
        mock_pygame.mixer.get_init.return_value = True
        self.player._arquivo_gerado = True

        self.player.play()

        mock_pygame.mixer.music.load.assert_called_once_with("faixa_gerada.mid")
        mock_pygame.mixer.music.play.assert_called_once()
        self.assertTrue(self.player._tocando)

    @patch("MusicPlayer.pygame")
    def test_play_retoma_quando_pausado(self, mock_pygame):
        # play() deve chamar unpause quando estiver pausado, sem recarregar o arquivo
        mock_pygame.mixer.get_init.return_value = True
        self.player._arquivo_gerado = True
        self.player._pausado        = True

        self.player.play()

        mock_pygame.mixer.music.unpause.assert_called_once()
        self.assertFalse(self.player._pausado)
        self.assertTrue(self.player._tocando)

    @patch("MusicPlayer.pygame")
    def test_play_ignorado_se_ja_tocando(self, mock_pygame):
        # play() não deve reiniciar se já houver reprodução em andamento
        mock_pygame.mixer.get_init.return_value = True
        self.player._arquivo_gerado = True
        self.player._tocando        = True

        self.player.play()

        mock_pygame.mixer.music.load.assert_not_called()

    # ── testes de pause ───────────────────────────────────────────────────

    @patch("MusicPlayer.pygame")
    def test_pause_quando_tocando(self, mock_pygame):
        # pause() deve pausar e atualizar os flags corretamente
        self.player._tocando = True
        self.player._pausado = False

        self.player.pause()

        mock_pygame.mixer.music.pause.assert_called_once()
        self.assertTrue(self.player._pausado)
        self.assertFalse(self.player._tocando)

    @patch("MusicPlayer.pygame")
    def test_pause_sem_estar_tocando_nao_faz_nada(self, mock_pygame):
        # pause() não deve chamar o pygame se não houver reprodução ativa
        self.player._tocando = False
        self.player.pause()
        mock_pygame.mixer.music.pause.assert_not_called()

    # ── testes de stop ────────────────────────────────────────────────────

    @patch("MusicPlayer.pygame")
    def test_stop_quando_tocando(self, mock_pygame):
        # stop() deve parar e zerar os dois flags
        self.player._tocando = True

        self.player.stop()

        mock_pygame.mixer.music.stop.assert_called_once()
        self.assertFalse(self.player._tocando)
        self.assertFalse(self.player._pausado)

    @patch("MusicPlayer.pygame")
    def test_stop_quando_pausado(self, mock_pygame):
        # stop() também deve funcionar quando a reprodução estiver pausada
        self.player._pausado = True

        self.player.stop()

        mock_pygame.mixer.music.stop.assert_called_once()
        self.assertFalse(self.player._pausado)

    @patch("MusicPlayer.pygame")
    def test_stop_sem_tocar_nao_faz_nada(self, mock_pygame):
        # stop() não deve chamar o pygame se não houver nada tocando
        self.player._tocando = False
        self.player._pausado = False
        self.player.stop()
        mock_pygame.mixer.music.stop.assert_not_called()

    # ── testes de restart ─────────────────────────────────────────────────

    @patch("MusicPlayer.pygame")
    def test_restart_para_e_reinicia(self, mock_pygame):
        # restart() deve chamar stop e depois play do início
        mock_pygame.mixer.get_init.return_value = True
        self.player._arquivo_gerado = True
        self.player._tocando        = True

        self.player.restart()

        mock_pygame.mixer.music.stop.assert_called_once()
        mock_pygame.mixer.music.load.assert_called_once()
        mock_pygame.mixer.music.play.assert_called_once()

    # ── testes de estado inicial ──────────────────────────────────────────

    def test_estado_inicial_correto(self):
        # ao criar o player, nada deve estar ativo
        self.assertFalse(self.player._arquivo_gerado)
        self.assertFalse(self.player._pausado)
        self.assertFalse(self.player._tocando)


if __name__ == "__main__":
    unittest.main(verbosity=2)
